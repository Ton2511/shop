<style>
  .bg-teal {
    background-color: #008080;
    color: white;
  }
  
  .btn-yellow {
    background-color: #FFC107;
    color: #212529;
  }
  
  .section-title {
    font-weight: 600;
    color: #333;
  }
  
  .product-item {
    transition: all 0.3s ease;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    overflow: hidden;
    height: 100%;
  }
  
  .product-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  
  .tab-image {
    max-width: 100%;
    max-height: 180px;
    object-fit: contain;
  }
  
  .a {
    text-decoration: none;
    color: inherit;
  }
  
  .category-thumbnail {
    width: 120px;
    height: 120px;
    object-fit: cover;
  }
  
  .category-title {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: #333;
  }

  /* Desktop — รูปเดิม */
  .hero-section {
    background-image: url('/images/banner-1.png');
  }

  /* มือถือ — รูปอื่น */
  @media (max-width: 767px) {
    .hero-section {
      background-image: url('/images/Medical Banner.jpg');
      min-height: 20vh !important;
      background-position: center center !important;
    }
  }

  /* ===== Feature Cards ===== */
  .feature-card .card {
    border-radius: 0;
  }

  .feature-card i {
    font-size: 2.5rem;
  }
  
  /* ===== Banner Blocks ===== */
  .banner-blocks {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }

  .banner-ad {
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .block-3 {
    border-radius: 8px;
    overflow: hidden;
    min-height: 160px;
  }

  .banner-content {
    background: rgba(0,0,0,0.35);
    min-height: 160px;
  }

  .block-1 {
    grid-column: span 3;
  }
  
  /* ===== Swiper ===== */
  .swiper-wrapper {
    padding: 10px 0;
  }
  
  /* .swiper-slide {
    height: auto;
  } */

  /* ===== Product Info ===== */
  .product-info {
    padding: 0.75rem;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price {
    font-size: 0.95rem;
    font-weight: 600;
    color: #008080;
    margin-bottom: 0.25rem;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: #666;
  }

  .product-category {
    background: #e8f5e9;
    color: #2e7d32;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.7rem;
  }

  /* ===== Section Header — เหมือน PC ทุก breakpoint ===== */
  .section-header {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: space-between !important;
  }

  .section-title {
    white-space: nowrap;
    margin-bottom: 0;
  }

  /* ===== Swiper Buttons — ขนาดเท่ากับ .btn ทุก breakpoint ===== */
  .swiper-buttons button {
    padding: 0.375rem 0.75rem !important;
    line-height: 1.5 !important;
    font-size: 1rem !important;
    width: auto !important;
    height: auto !important;
    border-radius: 4px;
  }

  /* ============================================
     MOBILE RESPONSIVE
  ============================================ */

  /* --- Tablet (≤768px) --- */
  @media (max-width: 768px) {
    .feature-card .card {
      padding: 1rem !important;
    }

    .banner-blocks {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .block-3:last-child {
      grid-column: span 2;
    }

    .tab-image {
      max-height: 140px;
    }

    .category-thumbnail {
      width: 80px;
      height: 80px;
    }

    
  }

  /* --- Mobile (≤576px) --- */
  @media (max-width: 576px) {

    /* Feature cards */
    .feature-card .card {
      padding: 0.75rem !important;
    }

    .feature-card i {
      font-size: 1.8rem;
    }

    .feature-card h5 {
      font-size: 0.9rem;
    }

    .feature-card p {
      font-size: 0.78rem;
      margin-bottom: 0;
    }

    /* Banner blocks */
    .banner-blocks {
      grid-template-columns: 1fr !important;
      gap: 8px;
    }

    .block-3 {
      min-height: 130px;
    }

    .block-3:last-child {
      grid-column: span 1;
    }

    .banner-content {
      min-height: 130px;
      padding: 1.25rem !important;
    }

    .banner-title {
      font-size: 1.1rem;
    }

    .banner-content p {
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
    }

    /* Section title */
    .section-title {
      font-size: 1.1rem;
    }

    /* ปุ่ม View All บน mobile */
    .section-header .btn {
      padding: 0.375rem 0.75rem !important;
      font-size: 0.875rem !important;
    }

    /* Product */
    .tab-image {
      max-height: 110px;
    }

    .product-item .p-3 {
      padding: 0.5rem !important;
    }

    .product-info {
      padding: 0.5rem;
    }

    .product-title {
      font-size: 0.8rem;
    }

    .product-price {
      font-size: 0.85rem;
    }

    /* Category */
    .category-thumbnail {
      width: 65px;
      height: 65px;
    }

    .category-title {
      font-size: 0.72rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 75px;
    }
  }

  /* --- Small mobile (≤480px) --- */
  @media (max-width: 480px) {
    .category-thumbnail {
      width: 60px !important;
      height: 60px !important;
    }

    .category-title {
      font-size: 0.75rem !important;
      max-width: 80px;
    }

    .section-title {
      font-size: 1rem;
    }
  }

  /* --- Very small (≤375px) --- */
  @media (max-width: 375px) {
    .category-thumbnail {
      width: 55px !important;
      height: 55px !important;
    }

    .category-title {
      font-size: 0.68rem !important;
      max-width: 65px;
    }

    .tab-image {
      max-height: 95px;
    }
  }

  @media (max-width: 576px) {
  .category-carousel .swiper-wrapper {
    padding: 5px 0;
  }

  /* .category-carousel .swiper-slide {
    padding: 0 2px;
  } */
}

  /* ===== FADE-UP ANIMATION ===== */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* delay ให้แต่ละ section ทยอยขึ้นมา */
  .fade-up:nth-child(1) { transition-delay: 0s; }
  .fade-up:nth-child(2) { transition-delay: 0.1s; }
  .fade-up:nth-child(3) { transition-delay: 0.2s; }
  .fade-up:nth-child(4) { transition-delay: 0.3s; }
  .fade-up:nth-child(5) { transition-delay: 0.4s; }
</style>

