<!-- ===== CATEGORY ===== -->
<section class="mt-4 pb-2 overflow-hidden fade-up">
  <div class="container-lg">
    <div class="row">
      <div class="col-md-12">
        <div class="section-header d-flex flex-wrap justify-content-between mb-1 mb-md-3">
          <h2 class="section-title text-dark">Category</h2>

          <div class="d-flex align-items-center">
            <a href="/shop" class="btn bg-teal text-light me-2">View All</a>
            <div class="swiper-buttons">
              <button class="swiper-prev category-carousel-prev btn bg-teal text-light">❮</button>
              <button class="swiper-next category-carousel-next btn bg-teal text-light">❯</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="category-carousel swiper">
          <div class="swiper-wrapper">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(category => { %>
                <a href="/shop/category/<%= category.id %>" class="nav-link swiper-slide text-center">
                  <% if (category.image) { %>
                    <img src="<%= category.image %>" class="rounded-circle category-thumbnail" alt="<%= category.name %>">
                  <% } else { %>
                    <div class="rounded-circle bg-light d-flex justify-content-center align-items-center category-thumbnail">
                      <i class="bi bi-collection fs-1 text-muted"></i>
                    </div>
                  <% } %>
                  <h4 class="fs-6 mt-2 fw-normal category-title"><%= category.name %></h4>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>



</section>


<!-- ===== BEST SELLING ===== -->
<section class="pb-2 fade-up">
  <div class="container-lg">
    <div class="row">
      <div class="col-md-12">
        <div class="section-header my-4">
          <h2 class="section-title text-dark">Best selling products</h2>
          <div class="d-flex align-items-center">
            <a href="/shop/products" class="btn bg-teal text-light rounded-1 me-2">View All</a>
            <div class="swiper-buttons">
              <button class="swiper-prev bestselling-carousel-prev btn bg-teal text-light">❮</button>
              <button class="swiper-next bestselling-carousel-next btn bg-teal text-light">❯</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-12">
        <div class="bestselling-carousel swiper">
          <div class="swiper-wrapper">
            <% if (featuredProducts && featuredProducts.length > 0) { %>
              <% featuredProducts.slice(0, 10).forEach(product => { %>
                <div class="swiper-slide">
                  <div class="product-card">
                    <a href="/shop/product/<%= product.id %>" class="a">
                      <figure class="m-0 p-3 text-center">
                        <% if (product.images && product.images.length > 0) { %>
                          <% const featuredImage = product.images.find(img => img.isFeatured) || product.images[0]; %>
                          <img src="<%= featuredImage.url %>" alt="<%= product.name %>" class="tab-image">
                        <% } else { %>
                          <div class="bg-light d-flex justify-content-center align-items-center py-4" style="height: 180px;">
                            <i class="bi bi-image fs-1 text-muted"></i>
                          </div>
                        <% } %>
                      </figure>
                      <div class="product-info">
                        <h3 class="product-title"><%= product.name %></h3>
                        <div class="product-price"><%= product.price || 'ติดต่อสอบถาม' %> ฿</div>
                        <div class="product-meta">
                          <% if (product.category) { %>
                            <span class="product-category"><%= product.category.name %></span>
                          <% } else { %>
                            <span class="product-category bg-secondary">ไม่มีหมวดหมู่</span>
                          <% } %>
                          <span class="product-views">
                            <i class="fa-solid fa-eye"></i> <%= product.fakeViews || 0 %>
                          </span>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="swiper-slide">
                <div class="col-12 text-center">
                  <p>ยังไม่มีสินค้าขายดี</p>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


